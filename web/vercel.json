{
  "buildCommand": "cd ../frontend && npm install && npx expo export --platform web && mkdir -p ../web/app && cp -r dist/* ../web/app/ && sed -i 's|src=\"/|src=\"/app/|g' ../web/app/index.html",
  "outputDirectory": ".",
  "installCommand": "echo 'No dependencies to install in web'",
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/app/favicon.ico" },
    { "source": "/Onboarding", "destination": "/app/index.html" },
    { "source": "/assets/(.*)", "destination": "/app/assets/$1" },
    { "source": "/_expo/(.*)", "destination": "/app/_expo/$1" },
    { "source": "/app/((?!.*\\.).*)", "destination": "/app/index.html" },
    { "source": "/verify-email", "destination": "/verify-email.html" },
    { "source": "/reset-password", "destination": "/reset-password.html" },
    { "source": "/achievements", "destination": "/achievements.html" },
    { "source": "/streak-reminder", "destination": "/streak-reminder.html" },
    { "source": "/weekly-report", "destination": "/weekly-report.html" }
  ]
}
