{
  "buildCommand": "cd frontend && npm install && npx expo export --platform web && rm -rf web/_expo web/assets web/index.html web/favicon.ico web/metadata.json && cp -r dist/* web/",
  "outputDirectory": "web",
  "installCommand": "echo 'No root dependencies'",
  "rewrites": [
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" },
    { "source": "/verify-email", "destination": "/verify-email.html" },
    { "source": "/reset-password", "destination": "/reset-password.html" },
    { "source": "/achievements", "destination": "/achievements.html" },
    { "source": "/streak-reminder", "destination": "/streak-reminder.html" },
    { "source": "/weekly-report", "destination": "/weekly-report.html" }
  ]
}
