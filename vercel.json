{
  "buildCommand": "cd frontend && npm install && npx expo export --platform web && mkdir -p ../web/public-app && rm -rf ../web/public-app/* && cp -r dist/* ../web/public-app/",
  "outputDirectory": "web",
  "installCommand": "echo 'No root dependencies'",
  "headers": [
    {
      "source": "/app/(.*\\.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/public-app/_expo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/public-app/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app/_expo/(.*)",
      "destination": "/public-app/_expo/$1"
    },
    {
      "source": "/app/((?!.*\\.).*)",
      "destination": "/public-app/index.html"
    },
    {
      "source": "/verify-email",
      "destination": "/verify-email.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    },
    {
      "source": "/achievements",
      "destination": "/achievements.html"
    },
    {
      "source": "/streak-reminder",
      "destination": "/streak-reminder.html"
    },
    {
      "source": "/weekly-report",
      "destination": "/weekly-report.html"
    }
  ]
}
