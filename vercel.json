{
  "buildCommand": "cd frontend && npm install && npx expo export --platform web && mkdir -p web/app && cp -r dist/* web/app/ && sed -i 's|src=\"/|src=\"/app/|g' web/app/index.html",  
  "outputDirectory": "web",
  "installCommand": "echo 'No root dependencies'",
  "headers": [
    {
      "source": "/app/(.*\\.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/_expo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/app/favicon.ico"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/app/assets/$1"
    },
    {
      "source": "/_expo/(.*)",
      "destination": "/app/_expo/$1"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/((?!.*\\.).*)",
      "destination": "/app/index.html"
    },
    {
      "source": "/Main/(.*)",
      "destination": "/app/index.html"
    },
    {
      "source": "/login",
      "destination": "/app/index.html"
    },
    {
      "source": "/register",
      "destination": "/app/index.html"
    },
    {
      "source": "/Onboarding",
      "destination": "/app/index.html"
    },
    {
      "source": "/lessons",
      "destination": "/app/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/app/index.html"
    },
    {
      "source": "/profile",
      "destination": "/app/index.html"
    },
    {
      "source": "/settings",
      "destination": "/app/index.html"
    },
    {
      "source": "/community",
      "destination": "/app/index.html"
    },
    {
      "source": "/culture",
      "destination": "/app/index.html"
    },
    {
      "source": "/practice",
      "destination": "/app/index.html"
    },
    {
      "source": "/verify-email",
      "destination": "/verify-email.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    },
    {
      "source": "/achievements",
      "destination": "/achievements.html"
    },
    {
      "source": "/streak-reminder",
      "destination": "/streak-reminder.html"
    },
    {
      "source": "/weekly-report",
      "destination": "/weekly-report.html"
    },
    {
      "source": "/((?!app/|_expo/|assets/|favicon\\.ico|verify-email|reset-password|achievements|streak-reminder|weekly-report).*)",
      "destination": "/app/index.html"
    }
  ]
}
